{%- comment -%} Gold scrolling strip of proof points (BoxUp's orange stats band, in gold). {%- endcomment -%}
{%- assign mq = '150+ brands served|250+ institutions|Gifting since 2012|Bulk orders from 50 pieces|Custom logo branding|GST invoicing|Pan-India delivery|4,000+ artisan families' | split: '|' -%}
<style>
  .mg-mq { background: linear-gradient(90deg, #a8841a, #c9a227 50%, #a8841a); color: #17110a; overflow: hidden; }
  .mg-mq__track { display: inline-flex; white-space: nowrap; animation: mg-mq 38s linear infinite; padding: .6rem 0; }
  .mg-mq__track span { font-weight: 700; font-size: .82rem; letter-spacing: .04em; padding-inline: 1.6rem; position: relative; }
  .mg-mq__track span::after { content: "✦"; position: absolute; right: -.35rem; opacity: .6; }
  .mg-mq:hover .mg-mq__track { animation-play-state: paused; }
  @keyframes mg-mq { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .mg-mq__track { animation: none; flex-wrap: wrap; white-space: normal; justify-content: center; } .mg-mq__track span[aria-hidden] { display: none; } }
</style>
<div class="mg-mq" role="region" aria-label="Why teams choose Meru Gifting">
  <div class="mg-mq__track">
    {%- for t in mq -%}<span>{{ t }}</span>{%- endfor -%}
    {%- for t in mq -%}<span aria-hidden="true">{{ t }}</span>{%- endfor -%}
  </div>
</div>
