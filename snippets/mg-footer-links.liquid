<style>
  .mg-footer { display: grid; grid-template-columns: 1.2fr repeat(5, 1fr); gap: 2rem; padding: 2.5rem 0 1rem; }
  .mg-footer h4 { font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 0.9rem; color: #C9A227; }
  .mg-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .mg-footer a { color: #a8a090; text-decoration: none; font-size: 0.9rem; }
  .mg-footer a:hover { color: #C9A227; }
  .mg-footer__contact li { color: #a8a090; font-size: 0.9rem; }
  .mg-footer__contact li { line-height: 1.5; }
  .mg-footer__brand--center { text-align: center; padding: 2.5rem 0 1.5rem; margin-top: 1.5rem; border-top: 1px solid rgba(201,162,39,0.18); }
  .mg-footer__brand--center img { width: min(340px, 70%); height: auto; display: block; margin: 0 auto 1.1rem; }
  .mg-footer__brand--center p { color: #a8a090; font-size: 1rem; letter-spacing: 0.03em; line-height: 1.6; margin: 0; }
  @media (max-width: 899px) { .mg-footer { grid-template-columns: repeat(2, 1fr); } .mg-footer__contact { grid-column: 1 / -1; } .mg-footer__brand--center img { width: min(260px, 70%); } }
</style>
<div class="mg-footer">
  <div class="mg-footer__contact">
    <h4>Contact Us</h4>
    <ul>
      <li><strong>Meru Gifting</strong></li>
      <li>#273/2, SC Road, 2nd Cross,<br>Gandhinagar, <span style="white-space:nowrap">Bangalore – 560 009</span></li>
      <li><a href="tel:+917892255078">+91 78922 55078</a></li>
      <li><a href="mailto:merugifting@gmail.com">merugifting@gmail.com</a></li>
      <li><a href="https://wa.me/917892255078" target="_blank" rel="noopener">WhatsApp Us</a></li>
    </ul>
  </div>
  {% for link in linklists.footer.links %}
    {% if link.links.size > 0 %}
      <div>
        <h4>{{ link.title }}</h4>
        <ul>
          {% for child in link.links limit: 10 %}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{% endfor %}
        </ul>
      </div>
    {% endif %}
  {% endfor %}
</div>
  <div class="mg-footer__brand mg-footer__brand--center">
    <a href="/"><img src="{{ 'mg-logo.png' | asset_url }}" alt="Meru Gifting" width="1730" height="1043" loading="lazy"></a>
    <p>Corporate gifts · Festive hampers · Artisanal mementos · Customised gifts</p>
  </div>
