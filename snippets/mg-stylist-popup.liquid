{%- comment -%}
  "Connect with a Product Stylist" WhatsApp popup.
  Appears 30s after page load, once per browser session. Closing it hides it for the rest of the session.
{%- endcomment -%}
{%- unless request.design_mode -%}
{%- capture mg_stylist_msg -%}Hi Meru Gifting, I'd like help from a Product Stylist to pick the right gift.{% if template.name == 'product' %} I'm looking at "{{ product.title }}": {{ shop.url }}{{ product.url }}{% endif %}{%- endcapture -%}
<style>
  .mg-stylist { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 1rem; background: rgba(0,0,0,.6); opacity: 0; pointer-events: none; visibility: hidden; transition: opacity .3s ease, visibility 0s linear .3s; }
  .mg-stylist__card { position: relative; width: min(22rem, 100%); background: #141210; color: #faf7f0; border: 1px solid rgba(201, 162, 39, .45); border-radius: 14px; box-shadow: 0 18px 50px rgba(0,0,0,.5); padding: 1.6rem 1.4rem 1.4rem; text-align: center; transform: scale(.96); transition: transform .3s ease; }
  .mg-stylist.is-open .mg-stylist__card { transform: none; }
  .mg-stylist.is-open { opacity: 1; pointer-events: auto; visibility: visible; transition: opacity .3s ease; }
  .mg-stylist__close { position: absolute; top: .5rem; right: .5rem; width: 2rem; height: 2rem; border: 0; border-radius: 50%; background: transparent; color: #a8a090; font-size: 1.35rem; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .mg-stylist__close:hover { color: #faf7f0; background: rgba(255,255,255,.06); }
  .mg-stylist__title { margin: 0; padding: 0 1.5rem; font-size: 1.1rem; font-weight: 700; line-height: 1.25; color: #faf7f0; }
  .mg-stylist__text { margin: .4rem 0 1rem; font-size: .92rem; line-height: 1.5; color: #a8a090; }
  .mg-stylist__btn { display: flex; align-items: center; justify-content: center; gap: .5rem; padding: .8rem 1rem; border-radius: 999px; background: #25D366; color: #fff !important; font-weight: 700; font-size: .95rem; text-decoration: none; }
  .mg-stylist__btn svg { width: 1.15rem; height: 1.15rem; fill: currentColor; }
  .mg-stylist__btn:focus-visible, .mg-stylist__close:focus-visible { outline: 2px solid #c9a227; outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .mg-stylist, .mg-stylist.is-open, .mg-stylist__card { transition: none; transform: none; } }
  @media print { .mg-stylist { display: none; } }
</style>
<div class="mg-stylist" id="MgStylist" role="dialog" aria-modal="true" aria-labelledby="MgStylistTitle" aria-hidden="true">
  <div class="mg-stylist__card">
  <button type="button" class="mg-stylist__close" aria-label="Close" data-mg-stylist-close>&times;</button>
  <p class="mg-stylist__title" id="MgStylistTitle">Need help choosing a gift?</p>
  <p class="mg-stylist__text">Talk to our Product Stylist on WhatsApp.</p>
  <a class="mg-stylist__btn" href="https://wa.me/917892255078?text={{ mg_stylist_msg | url_encode }}" target="_blank" rel="noopener" data-mg-stylist-cta><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 1.9 17.7L.3 23.7l6.2-1.6a11.8 11.8 0 0 0 5.6 1.4c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.2-6.1-3.4-8.2Zm-8.4 18.1c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4a9.8 9.8 0 1 1 8.3 4.6Z"/></svg>Chat on WhatsApp</a>
  </div>
</div>
<script>
  (function () {
    var KEY = 'mgStylistSeen';
    var el = document.getElementById('MgStylist');
    if (!el) return;
    var seen = false;
    try { seen = sessionStorage.getItem(KEY) === '1'; } catch (e) {}
    if (seen) return;
    function mark() { try { sessionStorage.setItem(KEY, '1'); } catch (e) {} }
    function close() { el.classList.remove('is-open'); el.setAttribute('aria-hidden', 'true'); mark(); }
    el.querySelector('[data-mg-stylist-close]').addEventListener('click', close);
    el.querySelector('[data-mg-stylist-cta]').addEventListener('click', function () { setTimeout(close, 300); });
    el.addEventListener('click', function (e) { if (e.target === el) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && el.classList.contains('is-open')) close(); });
    setTimeout(function () { el.classList.add('is-open'); el.setAttribute('aria-hidden', 'false'); mark(); }, 30000);
  })();
</script>
{%- endunless -%}
