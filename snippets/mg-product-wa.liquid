{%- comment -%} WhatsApp order CTA on product pages (all products) {%- endcomment -%}
{%- capture msg -%}Hi Meru Gifting, I'm interested in "{{ product.title }}"{% if product.selected_or_first_available_variant.sku != blank %} ({{ product.selected_or_first_available_variant.sku }}){% endif %}. Please share pricing for my quantity: {{ shop.url }}{{ product.url }}{%- endcapture -%}
<style>
  .mg-pwa { display: grid; gap: .6rem; margin: .25rem 0 .5rem; }
  .mg-pwa__btn { display: flex; align-items: center; justify-content: center; gap: .55rem; padding: .95rem 1.2rem; border-radius: 999px; background: #25D366; color: #fff !important; font-weight: 700; text-decoration: none; font-size: 1rem; }
  .mg-pwa__btn svg { width: 20px; height: 20px; fill: currentColor; }
  .mg-pwa__btn:focus-visible { outline: 2px solid #C9A227; outline-offset: 3px; }
  .mg-pwa__note { font-size: .85rem; color: #a8a090; margin: 0; line-height: 1.5; }
  .mg-pwa__note a { color: #C9A227; }
  .mg-pwa__perks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; list-style: none; padding: 0; margin: .4rem 0 0; }
  .mg-pwa__perks li { border: 1px solid rgba(201,162,39,.35); border-radius: 10px; padding: .55rem .7rem; font-size: .8rem; color: #e8e0cc; background: #141210; }
  .mg-pwa__perks strong { color: #f3c969; display: block; font-size: .85rem; }
  .mg-pwa__enq { color: #f3c969 !important; font-weight: 700; font-size: .88rem; text-align: center; }
</style>
<div class="mg-pwa">
  <a class="mg-pwa__btn" href="https://wa.me/917892255078?text={{ msg | url_encode }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 1.9 17.7L.3 23.7l6.2-1.6a11.8 11.8 0 0 0 5.6 1.4c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.2-6.1-3.4-8.2Zm-8.4 18.1c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4a9.8 9.8 0 1 1 8.3 4.6Z"/></svg>Get bulk price on WhatsApp</a>
  <a class="mg-pwa__enq" href="/pages/bulk-enquiry">Ordering 50+? Request a bulk quote with your logo →</a>
  <ul class="mg-pwa__perks">
    <li><strong>From 50 pcs</strong>Bulk slab pricing</li>
    <li><strong>Your logo</strong>Free mock-up first</li>
    <li><strong>GST invoice</strong>PO accepted</li>
    <li><strong>Pan-India</strong>Tracked delivery</li>
  </ul>
  {%- if product.tags contains 'hamper-2026' -%}<p class="mg-pwa__note">Price shown is indicative. Final price depends on contents, quantity &amp; branding. <a href="/pages/catalog">Download catalogs</a></p>{%- endif -%}
</div>
