{%- doc -%}
  BoxUp-style hero: headline + boxed perks on one side, hamper collage on the other.

  @param {string} [eyebrow]
  @param {string} [title] - HTML allowed; wrap the gold words in <em>
  @param {string} [subtitle]
  @param {string} [h1] - Collection handle for the large image
  @param {string} [h2] - Collection handle for the top-right image
  @param {string} [h3] - Collection handle for the bottom-right image
{%- enddoc -%}
{%- liquid
  assign c1 = collections[h1] | default: collections['corporate-gift-hampers']
  assign c2 = collections[h2] | default: collections['christmas-hampers']
  assign c3 = collections[h3] | default: collections['customer-works']
  assign i1 = c1.image | default: c1.products.first.featured_image
  assign i2 = c2.image | default: c2.products.first.featured_image
  assign i3 = c3.image | default: c3.products.first.featured_image
-%}
{%- capture wa -%}https://wa.me/917892255078?text={{ 'Hi Meru Gifting, I would like a quote for corporate gifts (quantity, budget per gift, delivery date):' | url_encode }}{%- endcapture -%}
<style>
  .mgh { position: relative; overflow: hidden; background:
      radial-gradient(55% 80% at 90% 10%, rgba(201,162,39,.20) 0%, transparent 60%),
      radial-gradient(45% 70% at 0% 100%, rgba(201,162,39,.12) 0%, transparent 60%),
      linear-gradient(135deg, #15110a 0%, #0b0b0b 55%, #0b0b0b 100%);
    border-bottom: 1px solid rgba(201,162,39,.3); color: #faf7f0; }
  .mgh__in { max-width: 1280px; margin: 0 auto; padding: clamp(2rem, 5vw, 3.75rem) clamp(1rem, 3vw, 2rem); display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .mgh__eyebrow { display: inline-block; color: #f3c969; border: 1px solid rgba(201,162,39,.45); background: rgba(201,162,39,.08); border-radius: 999px; padding: .38rem .9rem; font-size: .74rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; margin: 0 0 1.1rem; }
  .mgh__title { font-family: var(--mg-serif); font-size: clamp(2rem, 4.4vw, 3.4rem); line-height: 1.08; font-weight: 700; margin: 0 0 1rem; color: #faf7f0; }
  .mgh__title em { font-style: normal; color: #f3c969; }
  .mgh__sub { color: #d9d1bf; font-size: clamp(.98rem, 1.3vw, 1.08rem); line-height: 1.6; margin: 0 0 1.5rem; max-width: 36rem; }
  .mgh__perks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; margin: 0 0 1.6rem; padding: 0; list-style: none; max-width: 34rem; }
  .mgh__perks li { display: flex; align-items: center; gap: .7rem; border: 1px solid rgba(201,162,39,.45); border-radius: 12px; padding: .7rem .85rem; background: rgba(20,18,16,.7); }
  .mgh__perks svg { width: 28px; height: 28px; flex: none; color: #f3c969; }
  .mgh__perks strong { display: block; color: #faf7f0; font-size: .95rem; line-height: 1.2; }
  .mgh__perks span { color: #a8a090; font-size: .78rem; }
  .mgh__ctas { display: flex; flex-wrap: wrap; gap: .75rem; }
  .mgh__media { display: grid; grid-template-columns: 1.15fr .85fr; grid-template-rows: 1fr 1fr; gap: .8rem; height: clamp(320px, 38vw, 500px); }
  .mgh__media a { position: relative; display: block; overflow: hidden; border-radius: 16px; border: 1px solid rgba(201,162,39,.4); background: #1b1814; }
  .mgh__media a:first-child { grid-row: span 2; }
  .mgh__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
  .mgh__media a:hover img { transform: scale(1.04); }
  .mgh__media span { position: absolute; left: .7rem; bottom: .7rem; background: rgba(11,11,11,.82); color: #f3c969; font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: .35rem .7rem; border-radius: 999px; }
  @media (max-width: 899px) {
    .mgh__in { grid-template-columns: 1fr; }
    .mgh__media { height: 240px; order: -1; }
  }
  @media (max-width: 479px) { .mgh__perks { grid-template-columns: 1fr 1fr; gap: .5rem; } .mgh__perks li { padding: .55rem .6rem; gap: .45rem; } .mgh__perks svg { width: 22px; height: 22px; } .mgh__perks strong { font-size: .84rem; } .mgh__perks span { font-size: .7rem; } }
  @media (prefers-reduced-motion: reduce) { .mgh__media img { transition: none; } }
</style>
<section class="mgh" aria-label="Corporate gifting">
  <div class="mgh__in">
    <div>
      <p class="mgh__eyebrow">{{ eyebrow | default: 'Now booking · Christmas 2026 & New Year 2027' }}</p>
      <h1 class="mgh__title">{{ title | default: 'Corporate gifts &amp; hampers, <em>branded your way</em>' }}</h1>
      <p class="mgh__sub">{{ subtitle | default: 'Welcome kits, client hampers, festive boxes and artisanal mementos, curated, logo-branded and delivered across India from our Bengaluru studio.' }}</p>
      <ul class="mgh__perks">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="8" width="18" height="13" rx="1.5"/><path d="M3 12h18M12 8v13M12 8s-1.5-5-4.5-5S5 6 8 8m4 0s1.5-5 4.5-5S19 6 16 8"/></svg><div><strong>From 50 pieces</strong><span>Bulk pricing slabs</span></div></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 20h4l10-10-4-4L4 16v4Z"/><path d="m13.5 6.5 4 4"/></svg><div><strong>Your logo</strong><span>Free branding mock-up</span></div></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 3h10l2 3v15H5V6l2-3Z"/><path d="M9 11h6M9 15h6"/></svg><div><strong>GST invoice</strong><span>PO &amp; vendor onboarding</span></div></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg><div><strong>Pan-India</strong><span>Multi-address delivery</span></div></li>
      </ul>
      <div class="mgh__ctas">
        <a class="mg-btn mg-btn--gold" href="/pages/bulk-enquiry">Get a bulk quote</a>
        <a class="mg-btn mg-btn--outline" href="/pages/catalog">Download catalogue</a>
        <a class="mg-btn mg-btn--wa" href="{{ wa }}" target="_blank" rel="noopener">WhatsApp us</a>
      </div>
    </div>
    <div class="mgh__media">
      {%- if i1 -%}<a href="{{ c1.url }}"><img src="{{ i1 | image_url: width: 900 }}" srcset="{{ i1 | image_url: width: 500 }} 500w, {{ i1 | image_url: width: 900 }} 900w, {{ i1 | image_url: width: 1200 }} 1200w" sizes="(max-width: 899px) 55vw, 30vw" width="900" height="1100" alt="{{ c1.title | escape }}" loading="eager" fetchpriority="high"><span>{{ c1.title }}</span></a>{%- endif -%}
      {%- if i2 -%}<a href="{{ c2.url }}"><img src="{{ i2 | image_url: width: 600 }}" width="600" height="600" alt="{{ c2.title | escape }}" loading="eager"><span>{{ c2.title }}</span></a>{%- endif -%}
      {%- if i3 -%}<a href="{{ c3.url }}"><img src="{{ i3 | image_url: width: 600 }}" width="600" height="600" alt="{{ c3.title | escape }}" loading="eager"><span>Custom Branded Kits</span></a>{%- endif -%}
    </div>
  </div>
</section>
