{%- doc -%}
  Full-bleed hero carousel: one short line per slide, two CTAs.
  Slides reveal with a circular wipe that grows from the click point.
  On desktop the hero uses a custom cursor (small gold dot + thin trailing ring).
  Images are Gemini-generated and live in assets/mg-hero-*.jpg (-m = mobile size).
{%- enddoc -%}
{%- liquid
  assign quote_url = '/pages/bulk-enquiry'
  capture slides
    echo 'hamper|Gifts they will <em>remember.</em>|Corporate hampers|/collections/corporate-gift-hampers|Explore hampers'
    echo '~welcome|Welcome kits, <em>your logo.</em>|Onboarding kits|/collections/customer-works|See welcome kits'
    echo '~festive|Year-end gifting, <em>sorted.</em>|Christmas &amp; New Year|/collections/christmas-hampers|Shop festive'
  endcapture
  assign slides = slides | split: '~'
-%}
<style>
  .mgx { --mgx-h: clamp(460px, 74vh, 720px); position: relative; height: var(--mgx-h); overflow: hidden; background: #0b0b0b; color: #faf7f0; isolation: isolate; border-bottom: 1px solid rgba(201,162,39,.3); }
  .mgx__slide { position: absolute; inset: 0; visibility: hidden; z-index: 1; }
  .mgx__slide.is-active { visibility: visible; z-index: 2; }
  .mgx__slide.is-entering { visibility: visible; z-index: 3; animation: mgx-wipe 1.15s cubic-bezier(.77,0,.18,1) both; }
  @keyframes mgx-wipe {
    from { clip-path: circle(0% at var(--cx, 70%) var(--cy, 50%)); }
    to   { clip-path: circle(150% at var(--cx, 70%) var(--cy, 50%)); }
  }
  .mgx__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 74% 62%; transform: scale(1.06); }
  .mgx__slide.is-active .mgx__img, .mgx__slide.is-entering .mgx__img { animation: mgx-drift 9s ease-out both; }
  @keyframes mgx-drift { from { transform: scale(1.07) translate3d(1%, 0, 0); } to { transform: scale(1) translate3d(0, 0, 0); } }
  .mgx__slide::after { content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(90deg, rgba(11,11,11,.9) 0%, rgba(11,11,11,.55) 34%, rgba(11,11,11,0) 60%),
                linear-gradient(0deg, rgba(11,11,11,.55) 0%, rgba(11,11,11,0) 30%); }
  .mgx__copy { position: absolute; z-index: 2; left: max(clamp(1rem, 4vw, 2rem), calc((100% - 1280px) / 2 + 2rem)); top: 50%; transform: translateY(-50%); max-width: min(34rem, 88%); }
  .mgx__brand { display: block; width: clamp(150px, 13vw, 200px); height: auto; margin: 0 0 clamp(1.4rem, 3.2vh, 2.2rem); filter: drop-shadow(0 6px 18px rgba(0,0,0,.55)); animation: mgx-fade 1s ease .1s both; }
  .mgx__tag { display: inline-flex; align-items: center; gap: .55rem; margin: 0 0 1.1rem; color: #f3c969; font-size: .74rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
  .mgx__title { font-family: var(--mg-serif); font-size: clamp(2.3rem, 5.6vw, 4.6rem); line-height: 1.04; font-weight: 700; margin: 0 0 1.8rem; color: #faf7f0; letter-spacing: -.01em; }
  .mgx__title em { font-style: normal; color: #f3c969; }
  .mgx__w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: .08em; }
  .mgx__w > span { display: inline-block; transform: translateY(105%); }
  .mgx__slide.is-active .mgx__w > span, .mgx__slide.is-entering .mgx__w > span { animation: mgx-rise .9s cubic-bezier(.2,.8,.2,1) both; animation-delay: calc(.35s + var(--i) * .07s); }
  @keyframes mgx-rise { to { transform: translateY(0); } }
  .mgx__tag, .mgx__ctas { opacity: 0; }
  .mgx__slide.is-active .mgx__tag, .mgx__slide.is-entering .mgx__tag { animation: mgx-fade .7s ease .25s both; }
  .mgx__slide.is-active .mgx__ctas, .mgx__slide.is-entering .mgx__ctas { animation: mgx-fade .7s ease .75s both; }
  @keyframes mgx-fade { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .mgx__ctas { display: flex; flex-wrap: wrap; gap: .75rem; }
  .mgx__ctas .mg-btn { padding: .95rem 1.6rem; font-size: .95rem; }
  .mgx__ctas .mg-btn--outline { color: #faf7f0; border-color: rgba(250,247,240,.55); backdrop-filter: blur(4px); }
  .mgx__ctas .mg-btn--outline:hover { border-color: #f3c969; color: #f3c969; background: rgba(11,11,11,.35); }
  .mgx__ctas .mg-btn span { transition: transform .2s ease; }
  .mgx__ctas .mg-btn:hover span { transform: translateX(4px); }

  /* custom cursor (desktop, fine pointer only) */
  .mgx-cur { position: fixed; left: 0; top: 0; z-index: 2147483000; pointer-events: none; opacity: 0; transition: opacity .25s ease; }
  .mgx-cur.is-on { opacity: 1; }
  .mgx-cur__dot, .mgx-cur__ring { position: absolute; left: 0; top: 0; border-radius: 50%; will-change: transform; }
  .mgx-cur__dot { width: 6px; height: 6px; margin: -3px 0 0 -3px; background: #f3c969; }
  .mgx-cur__ring { width: 30px; height: 30px; margin: -15px 0 0 -15px; border: 1px solid rgba(243,201,105,.7); transition: width .25s ease, height .25s ease, margin .25s ease, background-color .25s ease; }
  .mgx-cur.is-link .mgx-cur__ring { width: 46px; height: 46px; margin: -23px 0 0 -23px; background: rgba(243,201,105,.12); }
  .mgx-cur.is-down .mgx-cur__ring { width: 22px; height: 22px; margin: -11px 0 0 -11px; }
  @media (hover: hover) and (pointer: fine) {
    .mgx.has-cur, .mgx.has-cur * { cursor: none !important; }
  }

  /* home desktop: show the header logo at the top-left, sized to fill the header row */
  @media (min-width: 750px) {
    .header-logo[data-hidden-on-home-page] { display: flex; }
    .header-logo[data-hidden-on-home-page] .header-logo__image { height: 54px !important; width: auto !important; max-width: 240px; }
  }

  @media (max-width: 749px) {
    .mgx { --mgx-h: min(640px, 82svh); }
    .mgx__img { object-position: 78% 50%; }
    .mgx__slide::after { background: linear-gradient(0deg, rgba(11,11,11,.95) 0%, rgba(11,11,11,.75) 38%, rgba(11,11,11,0) 70%); }
    .mgx__copy { top: auto; bottom: 2rem; transform: none; right: 1rem; max-width: none; }
    .mgx__title { margin-bottom: 1.3rem; }
    /* mobile header is a single row already, so keep its logo and skip the hero copy */
    .mgx__brand { display: none; }
    .header-logo[data-hidden-on-home-page] { display: flex; }
    .mgx__ctas { gap: .5rem; flex-wrap: nowrap; } .mgx__ctas .mg-btn { padding: .8rem .95rem; font-size: .82rem; white-space: nowrap; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mgx__slide.is-entering { animation: mgx-fadein .6s ease both; }
    @keyframes mgx-fadein { from { opacity: 0; } to { opacity: 1; } }
    .mgx__img, .mgx__slide .mgx__img { animation: none !important; transform: none; }
    .mgx__w > span { transform: none; animation: none !important; }
    .mgx__tag, .mgx__ctas, .mgx__brand { opacity: 1; animation: none !important; }
    .mgx-cur { display: none; }
  }
</style>
<section class="mgx" aria-roledescription="carousel" aria-label="Meru Gifting highlights" data-mgx>
  <h1 class="visually-hidden">Meru Gifting: corporate gifts and hampers, branded with your logo</h1>
  {%- for s in slides -%}
    {%- assign p = s | strip | split: '|' -%}
    {%- assign words = p[1] | replace: '<em>', '' | replace: '</em>', '' | split: ' ' -%}
    {%- assign em_from = p[1] | split: '<em>' | first | split: ' ' | size -%}
    <div class="mgx__slide{% if forloop.first %} is-active{% endif %}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ slides.size }}"{% unless forloop.first %} aria-hidden="true" inert{% endunless %}>
      <picture>
        <source media="(max-width: 749px)" srcset="{{ 'mg-hero-' | append: p[0] | append: '-m.jpg' | asset_url }}">
        <img class="mgx__img" src="{{ 'mg-hero-' | append: p[0] | append: '.jpg' | asset_url }}" width="2400" height="1350" alt="" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
      </picture>
      <div class="mgx__copy">
        {%- if template.name == 'index' -%}
        <img class="mgx__brand" src="{{ 'mg-logo-original.png' | asset_url }}" width="768" height="459" alt="{% if forloop.first %}Meru Gifting{% endif %}"{% unless forloop.first %} aria-hidden="true"{% endunless %}{% if forloop.first %} fetchpriority="high"{% endif %}>
        {%- endif -%}
        <p class="mgx__tag">{{ p[2] }}</p>
        <p class="mgx__title" aria-label="{{ p[1] | strip_html }}">
          {%- for w in words -%}
            {%- assign idx = forloop.index0 -%}
            <span class="mgx__w" aria-hidden="true"><span style="--i: {{ idx }}">{% if idx >= em_from %}<em>{{ w }}</em>{% else %}{{ w }}{% endif %}</span></span>{% unless forloop.last %} {% endunless %}
          {%- endfor -%}
        </p>
        <div class="mgx__ctas">
          <a class="mg-btn mg-btn--gold" href="{{ quote_url }}" data-mag>Get a bulk quote</a>
          <a class="mg-btn mg-btn--outline" href="{{ p[3] }}" data-mag>{{ p[4] }} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  {%- endfor -%}
</section>
<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root || !root.hasAttribute('data-mgx') || root.dataset.ready) return;
    root.dataset.ready = '1';
    var slides = [].slice.call(root.querySelectorAll('.mgx__slide'));
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var DUR = 6500, cur = 0, timer = null, busy = false, stopped = reduce, hovering = false, visible = true;

    function setOrigin(el, x, y) { el.style.setProperty('--cx', x + 'px'); el.style.setProperty('--cy', y + 'px'); }
    function go(n, x, y) {
      if (busy || n === cur) return;
      n = (n + slides.length) % slides.length;
      var prev = slides[cur], next = slides[n], r = root.getBoundingClientRect();
      setOrigin(next, x == null ? r.width * .7 : x, y == null ? r.height * .5 : y);
      busy = true;
      next.removeAttribute('aria-hidden'); next.removeAttribute('inert');
      next.classList.add('is-entering');
      cur = n;
      setTimeout(function () {
        prev.classList.remove('is-active'); prev.setAttribute('aria-hidden', 'true'); prev.setAttribute('inert', '');
        next.classList.remove('is-entering'); next.classList.add('is-active');
        busy = false;
      }, reduce ? 620 : 1180);
      schedule();
    }
    function schedule() {
      clearTimeout(timer);
      if (stopped || hovering || !visible) return;
      timer = setTimeout(function () { go(cur + 1); }, DUR);
    }
    root.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') go(cur + 1); else if (e.key === 'ArrowLeft') go(cur - 1);
    });
    // click empty image area = next slide, wipe grows from the click point
    root.addEventListener('click', function (e) {
      if (e.target.closest('a, button')) return;
      var r = root.getBoundingClientRect();
      go(cur + 1, e.clientX - r.left, e.clientY - r.top);
    });
    // swipe on touch
    var sx = null, sy = 0;
    root.addEventListener('touchstart', function (e) { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
    root.addEventListener('touchend', function (e) {
      if (sx == null) return;
      var t = e.changedTouches[0], dx = t.clientX - sx, r = root.getBoundingClientRect();
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(t.clientY - sy)) go(cur + (dx < 0 ? 1 : -1), t.clientX - r.left, t.clientY - r.top);
      sx = null;
    }, { passive: true });
    if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { visible = es[0].isIntersecting; schedule(); }).observe(root);
    document.addEventListener('visibilitychange', function () { visible = !document.hidden; schedule(); });
    schedule();

    // custom cursor + magnetic buttons
    if (reduce || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    var c = document.createElement('div');
    c.className = 'mgx-cur'; c.setAttribute('aria-hidden', 'true');
    c.innerHTML = '<div class="mgx-cur__ring"></div><div class="mgx-cur__dot"></div>';
    document.body.appendChild(c);
    root.classList.add('has-cur');
    var ring = c.firstChild, dot = c.lastChild;
    var mx = 0, my = 0, rx = 0, ry = 0, raf = null, mags = [].slice.call(root.querySelectorAll('[data-mag]'));
    function loop() {
      rx += (mx - rx) * .16; ry += (my - ry) * .16;
      dot.style.transform = 'translate3d(' + mx + 'px,' + my + 'px,0)';
      ring.style.transform = 'translate3d(' + rx + 'px,' + ry + 'px,0)';
      raf = Math.abs(mx - rx) + Math.abs(my - ry) > .1 ? requestAnimationFrame(loop) : null;
    }
    root.addEventListener('pointermove', function (e) {
      mx = e.clientX; my = e.clientY;
      if (!c.classList.contains('is-on')) { rx = mx; ry = my; c.classList.add('is-on'); }
      var link = e.target.closest('a, button');
      c.classList.toggle('is-link', !!link);
      var overCta = !!e.target.closest('.mgx__ctas');
      if (overCta !== hovering) { hovering = overCta; schedule(); }
      mags.forEach(function (m) {
        var b = m.getBoundingClientRect(), cx = b.left + b.width / 2, cy = b.top + b.height / 2, dx = mx - cx, dy = my - cy;
        var near = Math.abs(dx) < b.width / 2 + 30 && Math.abs(dy) < b.height / 2 + 30;
        m.style.transform = near ? 'translate(' + dx * .22 + 'px,' + dy * .3 + 'px)' : '';
      });
      if (!raf) raf = requestAnimationFrame(loop);
    });
    root.addEventListener('pointerleave', function () {
      c.classList.remove('is-on', 'is-link', 'is-down');
      mags.forEach(function (m) { m.style.transform = ''; });
      if (hovering) { hovering = false; schedule(); }
    });
    root.addEventListener('pointerdown', function () { c.classList.add('is-down'); });
    addEventListener('pointerup', function () { c.classList.remove('is-down'); });
  })();
</script>
