{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,viewport-fit=cover"
>
<meta
  name="theme-color"
  content="{{ settings.page_background_color | default: '#ffffff' }}"
>

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: settings.seo_default_description | default: shop.name
  assign og_description = og_description | strip_html | strip_newlines | truncate: 300

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  # Share image: page image -> theme default -> bundled asset
  assign og_image_url = blank
  assign og_image_width = blank
  assign og_image_height = blank
  assign og_image_alt = og_title
  if page_image
    assign og_image_url = page_image | image_url: width: 1200
    assign og_image_width = page_image.width
    assign og_image_height = page_image.height
    if page_image.alt != blank
      assign og_image_alt = page_image.alt
    endif
  elsif settings.social_share_image
    assign og_image_url = settings.social_share_image | image_url: width: 1200
    assign og_image_width = settings.social_share_image.width
    assign og_image_height = settings.social_share_image.height
  else
    assign og_image_url = 'og-default.jpg' | asset_url
    assign og_image_width = 1200
    assign og_image_height = 630
  endif
  assign og_image_url = og_image_url | replace: 'http://', 'https://'
  unless og_image_url contains 'https://'
    assign og_image_url = og_image_url | prepend: 'https:'
  endunless

  # Locale for Open Graph (en -> en_IN for an India-based store)
  assign og_locale = request.locale.iso_code | replace: '-', '_'
  if og_locale == 'en'
    assign og_locale = 'en_IN'
  endif

  # Pages that should not be indexed
  assign noindex = false
  if request.page_type == 'search' or request.page_type == '404' or request.page_type == 'cart' or request.page_type == 'password'
    assign noindex = true
  endif
  if request.page_type == 'collection'
    if request.url contains 'filter.' or request.url contains 'sort_by='
      assign noindex = true
    endif
  endif
-%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>
<meta
  property="og:locale"
  content="{{ og_locale }}"
>

<meta
  property="og:image"
  content="{{ og_image_url }}"
>
<meta
  property="og:image:secure_url"
  content="{{ og_image_url }}"
>
{%- if og_image_width != blank -%}
  <meta
    property="og:image:width"
    content="{{ og_image_width }}"
  >
  <meta
    property="og:image:height"
    content="{{ og_image_height }}"
  >
{%- endif -%}
<meta
  property="og:image:alt"
  content="{{ og_image_alt | escape }}"
>

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
  <meta
    property="product:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="product:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
  <meta
    property="product:availability"
    content="{% if product.available %}in stock{% else %}out of stock{% endif %}"
  >
{%- endif -%}

{%- if request.page_type == 'article' and article -%}
  <meta
    property="article:published_time"
    content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}"
  >
  {%- if article.author != blank -%}
    <meta
      property="article:author"
      content="{{ article.author | escape }}"
    >
  {%- endif -%}
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: '.com/' | last | split: '/' | first | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>
<meta
  name="twitter:image"
  content="{{ og_image_url }}"
>
<meta
  name="twitter:image:alt"
  content="{{ og_image_alt | escape }}"
>

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

<meta
  name="description"
  content="{{ og_description | escape }}"
>

{%- if noindex -%}
  <meta
    name="robots"
    content="noindex, follow"
  >
{%- else -%}
  <meta
    name="robots"
    content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  >
{%- endif -%}
