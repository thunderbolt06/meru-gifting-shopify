{% doc %}
  Progressive-enhancement JS + CSS for the interactive/media components used inside
  article bodies (data-mg-* attributes). Components degrade gracefully without JS.
  Rendered once on the article template via a custom-liquid section.
{% enddoc %}
<style>
  /* Media */
  .mg-gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; margin: 1.5rem 0; }
  .mg-gallery figure { margin: 0; border: 1px solid #e8e2d4; border-radius: 12px; overflow: hidden; background: #fff; }
  .mg-gallery img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
  .mg-gallery figcaption { font-size: 0.8rem; color: #6b6455; padding: 0.5rem 0.7rem; }
  .mg-products { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.85rem; margin: 1.5rem 0; }
  .mg-product { display: block; text-decoration: none; color: inherit; border: 1px solid #e8e2d4; border-radius: 12px; overflow: hidden; background: #fff; transition: transform .2s, box-shadow .2s; }
  .mg-product:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(0,0,0,.08); }
  .mg-product img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; background: #FAF7F0; }
  .mg-product__name { display: block; padding: 0.6rem 0.75rem 0.1rem; font-weight: 600; font-size: 0.9rem; line-height: 1.3; }
  .mg-product__price { display: block; padding: 0 0.75rem 0.7rem; color: #C9A227; font-weight: 700; font-size: 0.9rem; }
  .mg-hero-img { margin: 1.25rem 0; border-radius: 16px; overflow: hidden; }
  .mg-hero-img img { width: 100%; max-height: 420px; object-fit: cover; display: block; }
  .mg-hero-img figcaption { font-size: 0.85rem; color: #6b6455; padding: 0.5rem 0; }
  .mg-video { position: relative; aspect-ratio: 16/9; border-radius: 16px; overflow: hidden; background: #111; margin: 1.5rem 0; }
  .mg-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .mg-video__poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .85; }
  .mg-video__play { position: absolute; inset: 0; margin: auto; width: 76px; height: 76px; border-radius: 50%; border: 0; background: #C9A227; color: #111; font-size: 1.6rem; cursor: pointer; display: grid; place-items: center; }
  .mg-video__label { position: absolute; left: 1rem; bottom: 1rem; color: #FAF7F0; font-weight: 600; text-shadow: 0 1px 4px rgba(0,0,0,.6); }
  /* Interactive */
  .mg-widget { border: 1px solid #e8e2d4; border-radius: 16px; background: #FAF7F0; padding: 1.25rem 1.25rem 1.4rem; margin: 1.75rem 0; }
  .mg-widget h3 { margin: 0 0 0.25rem; font-size: 1.1rem; }
  .mg-widget > p { margin: 0 0 1rem; color: #6b6455; font-size: 0.92rem; }
  .mg-widget label { display: block; font-size: 0.85rem; font-weight: 600; margin: 0.6rem 0 0.25rem; }
  .mg-widget input[type=number], .mg-widget select { width: 100%; padding: 0.6rem 0.75rem; border: 1px solid #e8e2d4; border-radius: 10px; background: #fff; font: inherit; }
  .mg-widget input[type=range] { width: 100%; accent-color: #C9A227; }
  .mg-widget__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; }
  .mg-widget__result { margin-top: 1rem; background: #111; color: #FAF7F0; border-radius: 12px; padding: 1rem 1.1rem; display: grid; gap: 0.25rem; }
  .mg-widget__result strong { color: #C9A227; font-size: 1.35rem; }
  .mg-widget__result small { color: #d9d4c8; }
  .mg-widget__actions { margin-top: 0.9rem; display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .mg-chip { display: inline-block; border: 1px solid #C9A227; color: #111; background: #fff; border-radius: 999px; padding: 0.45rem 0.9rem; font-size: 0.88rem; cursor: pointer; font-weight: 600; }
  .mg-chip[aria-pressed=true], .mg-chip:hover { background: #C9A227; }
  .mg-tabs__nav { display: flex; gap: 0.4rem; flex-wrap: wrap; border-bottom: 1px solid #e8e2d4; margin: 1.5rem 0 0; }
  .mg-tabs__nav button { border: 0; background: none; padding: 0.7rem 1rem; font: inherit; font-weight: 600; cursor: pointer; color: #6b6455; border-bottom: 3px solid transparent; margin-bottom: -1px; }
  .mg-tabs__nav button[aria-selected=true] { color: #111; border-color: #C9A227; }
  .mg-tabs__panel { padding: 1rem 0 0.5rem; }
  .mg-tabs__panel[hidden] { display: none; }
  .mg-quiz__q { font-weight: 700; margin: 0.5rem 0; }
  .mg-quiz__opts { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
  .mg-quiz__answer[hidden] { display: none; }
  .mg-checklist { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.4rem; }
  .mg-checklist label { display: flex; gap: 0.6rem; align-items: flex-start; font-weight: 500; margin: 0; background: #fff; border: 1px solid #e8e2d4; border-radius: 10px; padding: 0.6rem 0.8rem; cursor: pointer; }
  .mg-checklist input { margin-top: 0.2rem; accent-color: #C9A227; }
  .mg-checklist label.is-done { text-decoration: line-through; color: #6b6455; }
  .mg-progress { height: 8px; background: #e8e2d4; border-radius: 999px; overflow: hidden; margin-top: 0.75rem; }
  .mg-progress span { display: block; height: 100%; background: #C9A227; width: 0; transition: width .25s; }
  .mg-compare { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1.5rem 0; }
  .mg-compare > div { border: 1px solid #e8e2d4; border-radius: 12px; padding: 1rem; background: #fff; }
  .mg-compare h4 { margin: 0 0 0.5rem; }
  .mg-compare.is-highlight > div[data-winner] { border-color: #C9A227; box-shadow: 0 0 0 3px #C9A22733; }
  @media (max-width: 749px) { .mg-compare { grid-template-columns: 1fr; } }
</style>
<script>
(function () {
  var fmt = function (n) { return '₹' + Math.round(n).toLocaleString('en-IN'); };

  /* Lazy YouTube: <div class="mg-video" data-mg-video="VIDEO_ID" data-title="..."> */
  document.querySelectorAll('[data-mg-video]').forEach(function (el) {
    var id = el.getAttribute('data-mg-video'); if (!id) return;
    var title = el.getAttribute('data-title') || 'Meru Gifting video';
    el.innerHTML = '<img class="mg-video__poster" src="https://i.ytimg.com/vi/' + id + '/hqdefault.jpg" alt="' + title.replace(/"/g, '&quot;') + '" loading="lazy">' +
      '<button class="mg-video__play" type="button" aria-label="Play video: ' + title.replace(/"/g, '&quot;') + '">&#9654;</button>' +
      '<span class="mg-video__label">' + title + '</span>';
    el.querySelector('button').addEventListener('click', function () {
      el.innerHTML = '<iframe src="https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0" title="' + title.replace(/"/g, '&quot;') + '" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
    });
  });

  /* Budget calculator: <div class="mg-widget" data-mg-calc> with [data-people] [data-per-person] [data-gst] [data-out] [data-out-total] [data-out-tier] [data-wa] */
  document.querySelectorAll('[data-mg-calc]').forEach(function (w) {
    var people = w.querySelector('[data-people]'), per = w.querySelector('[data-per-person]'), gst = w.querySelector('[data-gst]');
    var out = w.querySelector('[data-out]'), outTotal = w.querySelector('[data-out-total]'), outTier = w.querySelector('[data-out-tier]'), wa = w.querySelector('[data-wa]');
    var perLabel = w.querySelector('[data-per-person-label]');
    function tier(v) { return v < 500 ? 'Token appreciation (₹150–₹500): branded notebook, bottle, diya set' : v < 1500 ? 'Standard (₹500–₹1,500): 2–3 item gift box, hamper with branding' : v < 5000 ? 'Premium (₹1,500–₹5,000): curated hamper, tech + artisanal combo' : 'Executive (₹5,000+): Dharohar artisanal mementos, bespoke sets'; }
    function calc() {
      var p = +people.value || 0, v = +per.value || 0, g = gst && gst.checked ? 1.18 : 1;
      var sub = p * v, total = sub * g;
      if (perLabel) perLabel.textContent = fmt(v) + ' per person';
      if (out) out.textContent = fmt(sub);
      if (outTotal) outTotal.textContent = fmt(total) + (g > 1 ? ' incl. 18% GST' : ' before GST');
      if (outTier) outTier.textContent = tier(v);
      if (wa) wa.href = 'https://wa.me/917892255078?text=' + encodeURIComponent('Hi Meru Gifting, I need ' + p + ' gifts at about ' + fmt(v) + ' per person (budget ' + fmt(total) + '). Please share a catalogue and mock-up.');
    }
    w.addEventListener('input', calc); calc();
  });

  /* Tabs: <div data-mg-tabs><div class="mg-tabs__nav"><button>..</button></div><div class="mg-tabs__panel">..</div>... */
  document.querySelectorAll('[data-mg-tabs]').forEach(function (t) {
    var btns = t.querySelectorAll('.mg-tabs__nav button'), panels = t.querySelectorAll('.mg-tabs__panel');
    function show(i) { btns.forEach(function (b, j) { b.setAttribute('aria-selected', i === j); }); panels.forEach(function (p, j) { p.hidden = i !== j; }); }
    btns.forEach(function (b, i) { b.type = 'button'; b.setAttribute('role', 'tab'); b.addEventListener('click', function () { show(i); }); });
    show(0);
  });

  /* Quiz / recommender: <div class="mg-widget" data-mg-quiz> with .mg-chip[data-answer=key] and .mg-quiz__answer[data-for=key] */
  document.querySelectorAll('[data-mg-quiz]').forEach(function (q) {
    var chips = q.querySelectorAll('.mg-chip[data-answer]'), answers = q.querySelectorAll('.mg-quiz__answer');
    answers.forEach(function (a) { a.hidden = true; });
    chips.forEach(function (c) {
      c.type = 'button'; c.setAttribute('aria-pressed', 'false');
      c.addEventListener('click', function () {
        var key = c.getAttribute('data-answer');
        chips.forEach(function (x) { x.setAttribute('aria-pressed', x === c ? 'true' : 'false'); });
        answers.forEach(function (a) { a.hidden = a.getAttribute('data-for') !== key; });
      });
    });
  });

  /* Checklist with progress + localStorage: <ul class="mg-checklist" data-mg-checklist="key"> <li><label><input type=checkbox> text</label></li> */
  document.querySelectorAll('[data-mg-checklist]').forEach(function (list) {
    var key = 'mg-check-' + list.getAttribute('data-mg-checklist') + '-' + location.pathname;
    var boxes = list.querySelectorAll('input[type=checkbox]'); var saved = [];
    try { saved = JSON.parse(localStorage.getItem(key) || '[]'); } catch (e) {}
    var bar = document.createElement('div'); bar.className = 'mg-progress'; bar.innerHTML = '<span></span>'; list.after(bar);
    var count = document.createElement('p'); count.style.cssText = 'font-size:.85rem;color:#6b6455;margin:.4rem 0 0'; bar.after(count);
    function render() {
      var done = 0; boxes.forEach(function (b, i) { b.checked = !!saved[i]; b.closest('label').classList.toggle('is-done', b.checked); if (b.checked) done++; });
      bar.firstChild.style.width = (boxes.length ? done / boxes.length * 100 : 0) + '%';
      count.textContent = done + ' of ' + boxes.length + ' done' + (done === boxes.length && boxes.length ? ' — you are ready to order.' : '');
    }
    boxes.forEach(function (b, i) { b.addEventListener('change', function () { saved[i] = b.checked; try { localStorage.setItem(key, JSON.stringify(saved)); } catch (e) {} render(); }); });
    render();
  });

  /* Range slider that reveals a tier: <div class="mg-widget" data-mg-slider><input type=range data-range><span data-range-out></span><div data-tier="0-499">..</div> */
  document.querySelectorAll('[data-mg-slider]').forEach(function (s) {
    var r = s.querySelector('[data-range]'), o = s.querySelector('[data-range-out]'), tiers = s.querySelectorAll('[data-tier]');
    function upd() {
      var v = +r.value; if (o) o.textContent = fmt(v);
      tiers.forEach(function (t) { var p = t.getAttribute('data-tier').split('-'); t.hidden = !(v >= +p[0] && v <= +(p[1] || 1e9)); });
    }
    r.addEventListener('input', upd); upd();
  });

  /* Compare highlight: <div class="mg-compare" data-mg-compare> with buttons .mg-chip[data-pick=idx] elsewhere inside */
  document.querySelectorAll('[data-mg-compare]').forEach(function (c) {
    c.querySelectorAll('.mg-chip[data-pick]').forEach(function (b) {
      b.type = 'button';
      b.addEventListener('click', function () {
        var i = +b.getAttribute('data-pick'); c.classList.add('is-highlight');
        c.querySelectorAll(':scope > div').forEach(function (d, j) { if (i === j) d.setAttribute('data-winner', ''); else d.removeAttribute('data-winner'); });
      });
    });
  });
})();
</script>
