{%- doc -%}
  The 11 home-page categories (same labels, links and images as mg-category-strip),
  drawn in one of several styles for the landing pages.

  @param {string} style - 'rings' | 'chips' | 'pills' | 'tiles'
  @param {string} [skip] - Comma list of labels to leave out
{%- enddoc -%}
{%- capture items -%}Corporate Hampers|/collections/corporate-gift-hampers|c:corporate-gift-hampers~Festive Gifts|/collections/diwali-hampers|c:diwali-hampers~Christmas & New Year|/collections/christmas-hampers|c:christmas-hampers~Customer Works|/collections/customer-works|c:customer-works~Drinkware|/search?type=product&q=bottle+OR+flask+OR+mug+OR+tumbler+OR+sipper|f:MGH-2224-lifestyle.jpg~Diaries|/search?type=product&q=diary+OR+notebook+OR+pen+OR+planner|f:IMG_9297.jpg~Tech Gifts|/search?type=product&q=speaker+OR+charger+OR+earbuds+OR+%22power+bank%22+OR+gadget|f:mm8-hero-bamboo.jpg~Desk Essentials|/search?type=product&q=%22desk+organiser%22+OR+%22pen+stand%22+OR+clock+OR+%22desk+set%22+OR+lamp|f:LAMP-hero-bamboo.jpg~Awards & Mementos|/collections/types?q=Samman|f:MG-SMN-003.png~Artisanal Decor|/collections/artisanal-mementos|f:MG-DPT-169.png~Customised|/collections/customised-orders|c:customised-orders{%- endcapture -%}
{%- assign skips = skip | default: '' | split: ',' -%}
{%- assign lines = items | strip | split: '~' -%}
<ul class="mglp-cats mglp-cats--{{ style }}">
  {%- for line in lines -%}
    {%- assign parts = line | split: '|' -%}
    {%- if skips contains parts[0] -%}{%- continue -%}{%- endif -%}
    {%- assign src = parts[2] | strip -%}
    {%- assign key = src | slice: 2, 200 -%}
    {%- assign img = nil -%}
    {%- if src contains 'c:' -%}
      {%- assign col = collections[key] -%}
      {%- assign img = col.image | default: col.products.first.featured_image -%}
    {%- else -%}
      {%- assign img = images[key] -%}
    {%- endif -%}
    <li>
      <a href="{{ parts[1] | strip }}">
        <span class="mglp-ring">{%- if img -%}<img src="{{ img | image_url: width: 200, height: 200, crop: 'center' }}" width="200" height="200" alt="" loading="lazy" decoding="async">{%- endif -%}</span>
        <span class="mglp-cats__label">{{ parts[0] }}</span>
      </a>
    </li>
  {%- endfor -%}
</ul>
