{%- comment -%}
  BoxUp-style round category shortcuts under the header. Shown on browsing
  templates only (collections, search, corporate page) so product and
  checkout-adjacent pages stay focused. On the home page the strip is
  rendered by templates/index.json below the marquee instead.
{%- endcomment -%}
{%- liquid
  assign show = false
  case template.name
    when 'collection', 'list-collections', 'search'
      assign show = true
    when 'page'
      if template.suffix == 'corporate-gifting' or template.suffix == 'bulk-enquiry'
        assign show = true
      endif
  endcase
-%}
{%- if show -%}
{%- render 'mg-category-circles' -%}
{%- endif -%}

{% schema %}
{
  "name": "Meru category strip",
  "class": "mg-cats-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [],
  "presets": [{ "name": "Meru category strip" }]
}
{% endschema %}
