{%- comment -%}
  Landing page 1: Corporate Gift Finder (/pages/corporate-gift-finder).
  Three tap questions (occasion, budget, quantity) filter real products server-rendered from
  the occasion collections. Quantity shapes the WhatsApp / enquiry handoff.
{%- endcomment -%}
{%- render 'mg-lp-ui' -%}
{%- assign occs = 'onboarding|Onboarding|employee-welcome-kit-items~client|Client thank-you|corporate-gift-hampers,premium-corporate-gifts~festive|Festive|diwali-hampers,christmas-hampers~awards|Awards|awards-recognition-gifts' | split: '~' -%}
<div class="mglp mglpf" id="mglpf">
  <section class="mglpf-hero">
    <picture class="mglp-media">
      <source media="(max-width: 749px)" srcset="{{ 'mg-hero-hamper-m.jpg' | asset_url }}">
      <img src="{{ 'mg-hero-hamper.jpg' | asset_url }}" width="2400" height="1350" alt="Black corporate gift hamper with notebook, bamboo flask, brass seal and chocolates" fetchpriority="high">
    </picture>
    <div class="mglpf-in">
      <p class="mglp-eyebrow">Gifts they will remember</p>
      <h1 class="mglp-disp">Corporate gift finder: <em>pick in 3 taps</em></h1>
      <form class="mglpf-box" onsubmit="return false" aria-label="Find corporate gifts">
        <fieldset class="mglpf-row"><legend>Occasion</legend><div class="mglpf-opts" data-k="occ">
          {%- for o in occs -%}{%- assign op = o | split: '|' -%}<button type="button" class="mglp-chip" data-v="{{ op[0] }}" data-l="{{ op[1] }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ op[1] }}</button>{%- endfor -%}
        </div></fieldset>
        <fieldset class="mglpf-row"><legend>Budget per gift</legend><div class="mglpf-opts" data-k="bud">
          <button type="button" class="mglp-chip" data-v="0-499" data-l="Under ₹500" aria-pressed="false">Under ₹500</button>
          <button type="button" class="mglp-chip" data-v="500-1000" data-l="₹500 to ₹1,000" aria-pressed="true">₹500 to ₹1,000</button>
          <button type="button" class="mglp-chip" data-v="1001-2500" data-l="₹1,000 to ₹2,500" aria-pressed="false">₹1,000 to ₹2,500</button>
          <button type="button" class="mglp-chip" data-v="2501-999999" data-l="₹2,500+" aria-pressed="false">₹2,500+</button>
        </div></fieldset>
        <fieldset class="mglpf-row"><legend>Quantity</legend><div class="mglpf-opts" data-k="qty">
          <button type="button" class="mglp-chip" data-v="10 to 50" data-l="10 to 50" aria-pressed="false">10 to 50</button>
          <button type="button" class="mglp-chip" data-v="50 to 200" data-l="50 to 200" aria-pressed="true">50 to 200</button>
          <button type="button" class="mglp-chip" data-v="200+" data-l="200+" aria-pressed="false">200+</button>
        </div></fieldset>
        <div class="mglpf-go">
          <small>Logo on every piece, free mock-up, <b>shortlist in 1 working day</b></small>
          <a class="mg-btn mg-btn--gold" href="#mglpf-res">Show my gifts →</a>
        </div>
      </form>
    </div>
  </section>

  {%- render 'mg-lp-seo', part: 'answer' -%}
  <section class="mg-wrap mg-sec" id="mglpf-res" aria-live="polite">
    <div class="mglpf-res-h">
      <div>
        <p class="mglp-eyebrow" data-sum>Onboarding · ₹500 to ₹1,000</p>
        <h2 class="mg-head__title" data-count>Gifts ready for your logo</h2>
      </div>
      <div class="mglp-ctas">
        <a class="mg-btn mg-btn--wa" data-wa href="https://wa.me/917892255078" target="_blank" rel="noopener">Send me this shortlist</a>
        <a class="mg-btn mg-btn--outline" data-all href="/collections/employee-welcome-kit-items">See all →</a>
      </div>
    </div>
    <ul class="mglp-grid" data-grid>
      {%- for o in occs -%}
        {%- assign op = o | split: '|' -%}
        {%- assign handles = op[2] | split: ',' -%}
        {%- for h in handles -%}
          {%- for p in collections[h].products limit: 30 -%}
            {%- if p.featured_image -%}{%- render 'mg-lp-card', product: p, tags: op[0] -%}{%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endfor -%}
    </ul>
    <p class="mglp-empty" data-empty hidden>Nothing in stock for that mix yet. We can source it: <a class="mg-link" href="/pages/bulk-enquiry">share your brief →</a></p>
  </section>

  <section class="mg-wrap mg-sec mg-sec--tight">
    <div class="mg-head"><p class="mg-head__eyebrow">Prefer to browse?</p><h2 class="mg-head__title">Shop by category</h2></div>
    {%- render 'mg-lp-cats', style: 'chips' -%}
  </section>
  {%- render 'mg-lp-seo', part: 'more', hero: 'mg-hero-hamper.jpg' -%}
  <div class="mg-wrap mg-sec mg-sec--tight">{%- render 'mg-cta-pair' -%}</div>
</div>
<style>
  .mglpf-hero { position: relative; min-height: 640px; display: flex; align-items: center; overflow: hidden; }
  .mglpf-hero .mglp-media img { object-position: 72% 50%; }
  .mglpf-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11,11,11,.96) 0%, rgba(11,11,11,.84) 42%, rgba(11,11,11,.1) 78%); }
  .mglpf-in { position: relative; z-index: 1; width: 100%; max-width: var(--mg-page); margin: 0 auto; padding: 3.5rem clamp(1rem, 3vw, 2rem); display: flex; flex-direction: column; gap: 1.2rem; }
  .mglpf-in > * { max-width: 680px; }
  .mglpf-in .mglp-disp { font-size: clamp(2.2rem, 4.4vw, 3.4rem); }
  .mglpf-box { background: rgba(20,18,16,.92); border: 1px solid var(--mg-line-gold); border-radius: 18px; padding: 1.3rem 1.4rem; display: flex; flex-direction: column; gap: 1rem; backdrop-filter: blur(6px); }
  .mglpf-row { border: 0; margin: 0; padding: 0; display: grid; grid-template-columns: 8.5rem 1fr; gap: .8rem; align-items: center; min-width: 0; }
  .mglpf-row legend { float: left; font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; color: var(--mg-muted); font-weight: 700; padding: 0; }
  .mglpf-opts { display: flex; flex-wrap: wrap; gap: .45rem; }
  .mglpf-go { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; border-top: 1px solid var(--mg-line); padding-top: 1rem; }
  .mglpf-go small { color: var(--mg-muted); font-size: .84rem; } .mglpf-go small b { color: var(--mg-gold-soft); }
  .mglpf-res-h { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .mglpf-res-h .mg-head__title { margin-top: .4rem; }
  .mglpf .mglp-cats--chips { justify-content: center; }
  @media (max-width: 749px) {
    .mglpf-hero { min-height: 0; display: block; }
    .mglpf-hero .mglp-media { position: relative; height: 240px; }
    .mglpf-hero::after { height: 240px; background: linear-gradient(0deg, rgba(11,11,11,1) 0%, rgba(11,11,11,0) 60%); }
    .mglpf-in { margin-top: -5.5rem; padding-top: 0; padding-bottom: 2rem; }
    .mglpf-row { grid-template-columns: 1fr; gap: .45rem; }
    .mglpf-box { padding: 1.1rem; }
    .mglpf-go .mg-btn { width: 100%; }
  }
</style>
<script>
(function () {
  var root = document.getElementById('mglpf'); if (!root) return;
  var st = { occ: 'onboarding', bud: '500-1000', qty: '50 to 200' }, lab = { occ: 'Onboarding', bud: '₹500 to ₹1,000', qty: '50 to 200' };
  var all = { onboarding: '/collections/employee-welcome-kit-items', client: '/collections/corporate-gift-hampers', festive: '/collections/diwali-hampers', awards: '/collections/awards-recognition-gifts' };
  var items = [].slice.call(root.querySelectorAll('[data-grid] .mglp-item'));
  function run() {
    var r = st.bud.split('-'), lo = +r[0], hi = +r[1], n = 0, seen = {};
    items.forEach(function (li) {
      var p = +li.dataset.price, u = li.dataset.url;
      var ok = li.dataset.tags === st.occ && p >= lo && p <= hi && !seen[u] && n < 8;
      if (ok) { seen[u] = 1; n++; } li.hidden = !ok;
    });
    root.querySelector('[data-sum]').textContent = lab.occ + ' · ' + lab.bud + ' · ' + lab.qty + ' pieces';
    root.querySelector('[data-count]').textContent = n ? (n === 8 ? 'Top 8 gifts' : n + (n === 1 ? ' gift' : ' gifts')) + ' ready for your logo' : 'No ready match yet';
    root.querySelector('[data-empty]').hidden = n > 0;
    root.querySelector('[data-all]').href = all[st.occ];
    root.querySelector('[data-wa]').href = 'https://wa.me/917892255078?text=' + encodeURIComponent('Hi Meru Gifting, please send me a shortlist of ' + lab.occ.toLowerCase() + ' gifts, budget ' + lab.bud + ' per gift, quantity ' + lab.qty + ' pieces, with my logo.');
  }
  root.querySelectorAll('.mglpf-opts').forEach(function (g) {
    g.addEventListener('click', function (e) {
      var b = e.target.closest('button'); if (!b) return;
      g.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      st[g.dataset.k] = b.dataset.v; lab[g.dataset.k] = b.dataset.l; run();
    });
  });
  run();
})();
</script>
{% schema %}
{ "name": "MG landing: gift finder", "settings": [], "presets": [{ "name": "MG landing: gift finder" }] }
{% endschema %}
