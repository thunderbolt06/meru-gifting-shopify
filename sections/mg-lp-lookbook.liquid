{%- comment -%}
  Landing page 3: Gifting Lookbook (/pages/gifting-lookbook).
  Bento mosaic: all three hero photos at once, a proof tile and four category photo tiles.
{%- endcomment -%}
{%- render 'mg-lp-ui' -%}
{%- assign cw = collections['customer-works'] -%}
{%- assign cu = collections['customised-orders'] -%}
{%- assign img_cw = cw.image | default: cw.products.first.featured_image -%}
{%- assign img_cu = cu.image | default: cu.products.first.featured_image -%}
<div class="mglp mglpg">
  <div class="mg-wrap mglpg-wrap">
    <div class="mglpg-grid">
      <section class="mglpg-t mglpg-a">
        <picture class="mglp-media">
          <source media="(max-width: 749px)" srcset="{{ 'mg-hero-hamper-m.jpg' | asset_url }}">
          <img src="{{ 'mg-hero-hamper.jpg' | asset_url }}" width="2400" height="1350" alt="Black corporate gift hamper with notebook, bamboo flask, brass seal and chocolates" fetchpriority="high">
        </picture>
        <div class="mglpg-a__txt">
          <p class="mglp-eyebrow">Hampers, kits and mementos</p>
          <h1 class="mglp-disp">Corporate gifting <em>lookbook</em></h1>
          <div class="mglp-ctas"><a class="mg-btn mg-btn--gold" href="/pages/bulk-enquiry">Get a bulk quote</a><a class="mg-btn mg-btn--ghost" href="/collections/corporate-gift-hampers">Explore hampers →</a></div>
        </div>
      </section>
      <a class="mglpg-t mglpg-b mglpg-shade" href="/collections/employee-welcome-kit-items">
        <picture class="mglp-media"><source media="(max-width: 749px)" srcset="{{ 'mg-hero-welcome-m.jpg' | asset_url }}"><img src="{{ 'mg-hero-welcome.jpg' | asset_url }}" width="2400" height="1350" alt="Black employee welcome kit with notebook, bottle, card holder and pen" loading="lazy"></picture>
        <span class="mglpg-cap"><b>Welcome kits,<br>your logo.</b><span>Onboarding →</span></span>
      </a>
      <a class="mglpg-t mglpg-c mglpg-shade" href="/collections/christmas-hampers">
        <picture class="mglp-media"><source media="(max-width: 749px)" srcset="{{ 'mg-hero-festive-m.jpg' | asset_url }}"><img src="{{ 'mg-hero-festive.jpg' | asset_url }}" width="2400" height="1350" alt="Christmas and New Year corporate gift box" loading="lazy" style="object-position:30% 50%"></picture>
        <span class="mglpg-cap"><b>Christmas &amp;<br>New Year</b><span>Shop →</span></span>
      </a>
      <a class="mglpg-t mglpg-d" href="/pages/our-clients">
        <span class="mglp-eyebrow">Since 2012</span>
        <span><b>150+</b><small>brands and 250+ institutions</small></span>
      </a>
      <a class="mglpg-t mglpg-e mglpg-shade mglpg-contain" href="/collections/types?q=Samman">
        {%- assign im = images['MG-SMN-003.png'] -%}{%- if im -%}<img class="mglp-media" src="{{ im | image_url: width: 600 }}" width="600" height="600" alt="" loading="lazy">{%- endif -%}
        <span class="mglpg-cap"><b>Awards &amp; Mementos</b></span>
      </a>
      <a class="mglpg-t mglpg-f mglpg-shade" href="/collections/customer-works">
        {%- if img_cw -%}<img class="mglp-media" src="{{ img_cw | image_url: width: 700 }}" width="700" height="700" alt="" loading="lazy">{%- endif -%}
        <span class="mglpg-cap"><b>Customer Works</b><span>BITS Pilani</span></span>
      </a>
      <a class="mglpg-t mglpg-g mglpg-shade mglpg-contain" href="/collections/artisanal-mementos">
        {%- assign im = images['MG-DPT-169.png'] -%}{%- if im -%}<img class="mglp-media" src="{{ im | image_url: width: 600 }}" width="600" height="600" alt="" loading="lazy">{%- endif -%}
        <span class="mglpg-cap"><b>Artisanal Decor</b></span>
      </a>
      <a class="mglpg-t mglpg-h mglpg-shade" href="/collections/customised-orders">
        {%- if img_cu -%}<img class="mglp-media" src="{{ img_cu | image_url: width: 700 }}" width="700" height="700" alt="" loading="lazy">{%- endif -%}
        <span class="mglpg-cap"><b>Customised</b></span>
      </a>
    </div>
    {%- render 'mg-lp-seo', part: 'answer' -%}
    <div class="mglpg-also"><span>Also shop</span>{%- render 'mg-lp-cats', style: 'chips', skip: 'Christmas & New Year,Customer Works,Awards & Mementos,Artisanal Decor,Customised' -%}</div>
  </div>
  <div class="mg-wrap mg-sec">{%- render 'mg-product-grid', handle: 'corporate-gift-hampers', title: 'Corporate gift hampers', eyebrow: 'Ready to brand', limit: 8 -%}</div>
  <div class="mg-wrap mg-sec">{%- render 'mg-case-studies' -%}</div>
  {%- render 'mg-lp-seo', part: 'more', hero: 'mg-hero-hamper.jpg' -%}
  <div class="mg-wrap mg-sec mg-sec--tight">{%- render 'mg-cta-pair' -%}</div>
</div>
<style>
  .mglpg-wrap { padding-block: 1.75rem 0; }
  .mglpg-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: 300px 220px 230px; gap: .9rem; }
  .mglpg-t { position: relative; border-radius: 18px; overflow: hidden; background: var(--mg-surface); border: 1px solid var(--mg-line); text-decoration: none; color: var(--mg-text); display: block; }
  .mglpg-t .mglp-media { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .mglpg-t .mglp-media img { transition: transform .6s ease; }
  a.mglpg-t:hover .mglp-media, a.mglpg-t:hover .mglp-media img { transform: scale(1.04); }
  a.mglpg-t:hover { border-color: var(--mg-line-gold); }
  .mglpg-shade::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(11,11,11,.9), rgba(11,11,11,0) 55%); }
  .mglpg-contain .mglp-media { object-fit: contain; background: #0f0e0c; padding: 1rem; }
  .mglpg-cap { position: absolute; left: 1.2rem; right: 1.2rem; bottom: 1.1rem; z-index: 1; display: flex; justify-content: space-between; align-items: flex-end; gap: .5rem; }
  .mglpg-cap b { font-family: var(--mg-serif); font-size: clamp(1.1rem, 1.8vw, 1.5rem); line-height: 1.1; }
  .mglpg-cap span { font-size: .72rem; color: var(--mg-gold-soft); letter-spacing: .14em; text-transform: uppercase; font-weight: 700; white-space: nowrap; }
  .mglpg-a { grid-column: 1 / 8; grid-row: 1 / 3; }
  .mglpg-a .mglp-media img { object-position: 72% 50%; }
  .mglpg-a::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11,11,11,.93), rgba(11,11,11,.35) 58%, rgba(11,11,11,0)); }
  .mglpg-a__txt { position: absolute; z-index: 1; left: clamp(1.25rem, 3vw, 2.5rem); bottom: clamp(1.25rem, 3vw, 2.5rem); max-width: 26rem; display: flex; flex-direction: column; gap: 1rem; }
  .mglpg-a .mglp-disp { font-size: clamp(2.2rem, 4.4vw, 3.6rem); }
  .mglpg-b { grid-column: 8 / 13; grid-row: 1 / 2; }
  .mglpg-c { grid-column: 8 / 11; grid-row: 2 / 3; }
  .mglpg-d { grid-column: 11 / 13; grid-row: 2 / 3; background: linear-gradient(160deg, #2a2210, #14110a); padding: 1.1rem; display: flex; flex-direction: column; justify-content: space-between; }
  .mglpg-d .mglp-eyebrow { font-size: .66rem; }
  .mglpg-d b { display: block; font-family: var(--mg-serif); font-size: clamp(2rem, 3.4vw, 2.8rem); color: var(--mg-gold-soft); line-height: 1; }
  .mglpg-d small { font-size: .8rem; color: var(--mg-muted); }
  .mglpg-e { grid-column: 1 / 4; grid-row: 3; } .mglpg-f { grid-column: 4 / 7; grid-row: 3; } .mglpg-g { grid-column: 7 / 10; grid-row: 3; } .mglpg-h { grid-column: 10 / 13; grid-row: 3; }
  .mglpg-also { display: flex; align-items: center; gap: 1rem; justify-content: center; flex-wrap: wrap; padding: 1.5rem 0 .5rem; color: var(--mg-muted); font-size: .85rem; }
  @media (max-width: 989px) {
    .mglpg-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; grid-auto-rows: 190px; }
    .mglpg-a { grid-column: 1 / -1; grid-row: span 2; }
    .mglpg-b { grid-column: 1 / -1; grid-row: auto; }
    .mglpg-c, .mglpg-d, .mglpg-e, .mglpg-f, .mglpg-g, .mglpg-h { grid-column: auto; grid-row: auto; }
  }
  @media (max-width: 749px) {
    .mglpg-grid { grid-auto-rows: 170px; gap: .6rem; }
    .mglpg-a { grid-row: span 3; }
    .mglpg-a::after { background: linear-gradient(0deg, rgba(11,11,11,.95), rgba(11,11,11,.2) 70%); }
    .mglpg-a .mglp-ctas { flex-wrap: nowrap; } .mglpg-a .mglp-ctas .mg-btn { flex: 1; white-space: nowrap; padding: .8rem .7rem; font-size: .82rem; }
    .mglpg-cap { left: .8rem; right: .8rem; bottom: .7rem; flex-direction: column; align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) { .mglpg-t .mglp-media, .mglpg-t .mglp-media img { transition: none; } }
</style>
{% schema %}
{ "name": "MG landing: lookbook", "settings": [], "presets": [{ "name": "MG landing: lookbook" }] }
{% endschema %}
