{%- comment -%} BoxUp-style announcement bar: enquiry line in the middle, call + catalogue on the right. {%- endcomment -%}
<style>
  .mg-topbar { background: linear-gradient(90deg, #1a1408, #2a200b 50%, #1a1408); border-bottom: 1px solid rgba(201,162,39,.35); color: #faf7f0; font-size: .78rem; }
  .mg-topbar__in { max-width: 1440px; margin: 0 auto; padding: .5rem clamp(1rem, 3vw, 2rem); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; }
  .mg-topbar__msg { grid-column: 2; text-align: center; margin: 0; letter-spacing: .02em; }
  .mg-topbar__msg a { color: #f3c969; font-weight: 700; text-underline-offset: 3px; }
  .mg-topbar__right { grid-column: 3; display: flex; justify-content: flex-end; align-items: center; gap: 1rem; }
  .mg-topbar__right a { color: #faf7f0; text-decoration: none; display: inline-flex; align-items: center; gap: .4rem; font-weight: 600; white-space: nowrap; }
  .mg-topbar__right a:hover { color: #f3c969; }
  .mg-topbar__right svg { width: 14px; height: 14px; }
  .mg-topbar__cat { background: #c9a227; color: #17110a !important; padding: .32rem .75rem; border-radius: 999px; }
  .mg-topbar__cat:hover { background: #f3c969; }
  @media (max-width: 989px) {
    .mg-topbar__in { grid-template-columns: 1fr; padding-block: .45rem; }
    .mg-topbar__msg { grid-column: 1; }
    .mg-topbar__right { display: none; }
    .mg-topbar__msg { font-size: .72rem; }
  }
</style>
<div class="mg-topbar">
  <div class="mg-topbar__in">
    <p class="mg-topbar__msg">{{ section.settings.message }} <a href="{{ section.settings.link }}">{{ section.settings.link_label }}</a></p>
    <div class="mg-topbar__right">
      <a href="tel:{{ section.settings.phone | remove: ' ' }}" aria-label="Call for bulk orders {{ section.settings.phone }}"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>Bulk orders: {{ section.settings.phone }}</a>
      <a class="mg-topbar__cat" href="/pages/catalog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 17v3h16v-3"/></svg>Download Catalogue</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Meru top bar",
  "class": "mg-topbar-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "message", "label": "Message", "default": "Bulk & corporate gifting from 10 pieces, with your logo." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Enquire now" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+91 78922 55078" }
  ],
  "presets": [{ "name": "Meru top bar" }]
}
{% endschema %}
